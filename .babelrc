{
  "comments": false,
  "env": {
    "test": {
      "presets": [
        ["@babel/preset-env", { "targets": { "node": 14 }}],
        "@babel/preset-typescript"
      ],
      "plugins": [
        ["@babel/plugin-proposal-decorators", { "legacy": true }],
        ["@babel/plugin-proposal-class-properties"]
      ]
    },
    "main": {
      "presets": [
        ["@babel/preset-env", {
          "targets": { "node": 14 }
        }]
      ]
    },
    "renderer": {
      "presets": [
        ["@babel/preset-env", { "modules": false }]
      ]
    },
    "web": {
      "presets": [
        ["@babel/preset-env", { "modules": false }]
      ]
    }
  },
  "plugins": [
    "@babel/plugin-transform-runtime"
  ]
}
