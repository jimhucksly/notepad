{
  "name": "notepad.dn-web.app",
  "version": "1.0.0",
  "author": "DN-WEB <admin@dn-web.ru>",
  "url": "https://dn-web.ru",
  "description": "An electron-vue project",
  "license": "DN-WEB <admin@dn-web.ru>",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node config/runner.js",
    "serve": "nodemon api/server.js",
    "build": "node config/build.js && electron-builder -w",
    "test": "cross-env NODE_ENV=test DEBUG_MODE=1 JEST_ELECTRON_STARTUP_ARGS='--no-sandbox' ELECTRON_DISABLE_SECURITY_WARNINGS=1 jest --no-cache",
    "test:unit": "cross-env NODE_ENV=test DEBUG_MODE=1 UNIT=1 JEST_ELECTRON_STARTUP_ARGS='--no-sandbox' ELECTRON_DISABLE_SECURITY_WARNINGS=1 jest --no-cache"
  },
  "build": {
    "productName": "Notepad App",
    "appId": "com.example.notepad-dn-web",
    "copyright": "Copyright © 2019-2021 ${author}",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "dist/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@babel/cli": "^7.15.7",
    "@types/auto-launch": "^5.0.1",
    "@types/lodash": "^4.14.149",
    "@types/markdown-it": "^0.0.9",
    "@types/markdown-it-anchor": "^4.0.3",
    "@types/simplemde": "^1.11.7",
    "@types/vue": "^2.0.0",
    "@types/webpack-env": "^1.16.0",
    "axios": "^0.23.0",
    "json-formatter-js": "^2.3.3",
    "nodemailer": "^6.9.1",
    "simplemde": "^1.11.2",
    "vue": "^3.2.20",
    "vue-electron": "^1.0.6",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-decorators": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.8.3",
    "@babel/preset-env": "^7.8.4",
    "@babel/runtime": "^7.8.4",
    "@ljharb/eslint-config": "^17.2.0",
    "@types/jest": "^29.2.2",
    "@types/lodash-es": "^4.17.6",
    "@typescript-eslint/eslint-plugin": "^4.31.2",
    "@typescript-eslint/parser": "^4.31.2",
    "@vue/compiler-sfc": "^3.2.20",
    "@vue/test-utils": "^2.2.1",
    "animejs": "^3.2.1",
    "auto-launch": "^5.0.5",
    "body-parser": "^1.20.1",
    "brace": "^0.11.1",
    "copy-webpack-plugin": "^6.3.0",
    "cross-env": "^5.2.1",
    "css-loader": "^6.3.0",
    "del": "^3.0.0",
    "electron": "^13.5.1",
    "electron-builder": "^22.14.13",
    "electron-dl": "^3.2.1",
    "eslint": "^7.13.0",
    "eslint-config-standard": "^11.0.0",
    "eslint-formatter-friendly": "^7.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-standard": "^3.1.0",
    "eslint-plugin-vue": "^7.1.0",
    "eslint-plugin-vue-libs": "^4.0.0",
    "eslint-webpack-plugin": "^2.2.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "fork-ts-checker-webpack-plugin": "^6.1.0",
    "html-webpack-plugin": "^5.3.2",
    "inversify": "^5.0.1",
    "javascript-state-machine": "^3.1.0",
    "lodash-es": "^4.17.21",
    "markdown-it": "^12.2.0",
    "markdown-it-anchor": "^8.3.1",
    "mini-css-extract-plugin": "^2.3.0",
    "multispinner": "^0.2.1",
    "node-gyp": "^8.3.0",
    "node-sass": "^6.0.1",
    "nodemon": "^2.0.20",
    "pg": "^8.9.0",
    "reflect-metadata": "^0.1.13",
    "require-dir": "^1.0.0",
    "sass": "^1.55.0",
    "sass-loader": "^12.1.0",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "style-loader": "^2.0.0",
    "terser-webpack-plugin": "^4.2.3",
    "ts-loader": "^9.2.6",
    "typescript": "^4.4.3",
    "vue-class-component": "^8.0.0-rc.1",
    "vue-eslint-parser": "^7.1.1",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^16.8.1",
    "vue-property-decorator": "^10.0.0-rc.3",
    "vue-router": "^4.0.12",
    "vue-style-loader": "^4.1.0",
    "vue2-ace-editor": "^0.0.15",
    "vuex-class": "^0.3.2",
    "webpack": "^5.53.0",
