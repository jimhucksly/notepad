{
  "name": "notepad.dn-web.app",
  "version": "1.0.0",
  "author": "DN-WEB <admin@dn-web.ru>",
  "url": "https://dn-web.ru",
  "license": "MIT",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node config/runner.js",
    "serve": "ts-node-dev api/server.ts",
    "build": "node config/build.js && electron-builder -w && npm run zip",
    "module": "node config/create-module.js",
    "test": "jest --runInBand --no-cache --collect-coverage",
    "lint": "npx eslint --cache --ext .ts src",
    "zip": "node gulp/index.js"
  },
  "build": {
    "productName": "Notepad App",
    "appId": "com.example.notepad-dn-web",
    "copyright": "Copyright © 2019-2026 ${author}",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "icon": "dist/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": ""
  },
