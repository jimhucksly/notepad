{
  "name": "notepad.dn-web.app",
  "version": "1.0.0",
  "author": "DN-WEB <admin@dn-web.ru>",
  "url": "https://dn-web.ru",
  "description": "An electron-vue project",
  "license": "DN-WEB <admin@dn-web.ru>",
  "main": "./dist/main.js",
  "path": "notepad-app",
  "scripts": {
    "dev": "node config/runner.js",
    "serve": "ts-node-dev api/server.ts",
    "build": "node config/build.js && electron-builder -w && npm run zip",
    "module": "node config/create-module.js",
    "test": "jest --runInBand --no-cache --collect-coverage",
    "zip": "node gulp/index.js"
  },
  "build": {
    "productName": "Notepad App",
    "appId": "com.example.notepad-dn-web",
    "copyright": "Copyright © 2019-2023 ${author}",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "!node_modules/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "dist/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@babel/cli": "^7.15.7",
    "@types/auto-launch": "^5.0.1",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.14.149",
    "@types/markdown-it": "^0.0.9",
    "@types/markdown-it-anchor": "^4.0.3",
    "@types/node": "^18.15.11",
    "@types/nodemailer": "^6.4.7",
    "@types/pg": "^8.6.6",
    "@types/vue": "^2.0.0",
    "@types/webpack-env": "^1.16.0",
    "axios": "^0.23.0",
    "gulp": "^4.0.2",
    "gulp-zip": "^5.1.0",
    "json-formatter-js": "^2.3.3",
    "nodemailer": "^6.9.1",
    "prompt": "^1.3.0",
    "vue": "^3.2.47",
    "vue-electron": "^1.0.6",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-decorators": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.8.3",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@babel/runtime": "^7.8.4",
    "@ljharb/eslint-config": "^17.2.0",
